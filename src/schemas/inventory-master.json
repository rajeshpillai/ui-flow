{
  "title": "Inventory Master",
  "layout": "two-column",
  "fields": [
    {
      "name": "inventoryName",
      "label": "Inventory Name",
      "type": "text",
      "required": true,
      "tab": "General",
      "section": "Basic Info"
    },
    {
      "name": "type",
      "label": "Type",
      "type": "dropdown",
      "options": ["Physical", "Digital"],
      "required": true,
      "tab": "General",
      "section": "Basic Info"
    },
    {
      "name": "startDate",
      "label": "Start Date",
      "type": "date",
      "tab": "General",
      "section": "Dates"
    },
    {
      "name": "endDate",
      "label": "End Date",
      "type": "date",
      "tab": "General",
      "section": "Dates"
    },
    {
      "name": "details",
      "type": "grid",
      "label": "Inventory Items",
      "config": {
        "display": "inline"  
      },
      "columns": [
        {
          "name": "itemCode",
          "label": "Item Code",
          "type": "dropdown",
          "lookupUrl": "http://localhost:4000/api/items/lookup",
          "required": true
        },
        {
          "name": "description",
          "label": "Description",
          "type": "text"
        },
        {
          "name": "quantity",
          "label": "Quantity",
          "type": "number",
          "validation": {
            "range": {
              "min": 1,
              "max": 10000
            }
          }
        },
        {
          "name": "price",
          "label": "Unit Price",
          "type": "number"
        },
        {
          "name": "total",
          "label": "Total",
          "type": "number",
          "calculated": "quantity * price"
        }
      ]
    }
  ]
}